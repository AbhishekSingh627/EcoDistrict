# EcoDistrict — Environment Configuration
# Copy this file to .env (never commit .env to version control)

# ── Backend ───────────────────────────────────────────────────────────────────
# Database URL (default: SQLite local file)
DATABASE_URL=sqlite:///./ecodistrict.db

# ── AI / Dataset Curation ─────────────────────────────────────────────────────
# Required for POST /api/ai/verify-image (Gemini dataset-curation assistant).
# Get a key at https://aistudio.google.com/app/apikey
# NEVER commit your real key — add it only to your private .env file.
GEMINI_API_KEY=

# ── Future (Phase 2 / Phase 3) ────────────────────────────────────────────────
# Add these when the corresponding features are implemented.
# Do NOT add values here — only add them to your private .env file.

# Secret key for JWT tokens (Phase 2)
# SECRET_KEY=your-secret-key-here

# Google Maps API key (Phase 2, optional — OSM is used by default)
# GOOGLE_MAPS_API_KEY=

# Email service (Phase 3)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
